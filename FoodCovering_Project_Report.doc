<hr>

<h2>APPENDIX</h2>
<h3>A. Core Pipeline Source Code (usePipelineStore.ts)</h3>
<pre>
import { create } from 'zustand';
import { io, Socket } from 'socket.io-client';

interface PipelineState {
  socket: Socket | null;
  isConnected: boolean;
  kpi: any;
  tracking: any;
  cityMap: any;
  connect: () => void;
}

export const usePipelineStore = create&lt;PipelineState&gt;((set, get) => ({
  socket: null,
  isConnected: false,
  kpi: {},
  tracking: {},
  cityMap: {},
  
  connect: () => {
    const socket = io('http://localhost:5000');
    socket.on('pipelineData', (data) => {
      set({ kpi: data.kpi, tracking: data.tracking, cityMap: data.cityMap });
    });
    set({ socket });
  }
}));
</pre>

